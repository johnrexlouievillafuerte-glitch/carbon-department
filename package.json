{
  "name": "carbon-department",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,public,admin -c blue,green,magenta \"pnpm --filter @carbon/server dev\" \"pnpm --filter @carbon/public dev\" \"pnpm --filter @carbon/admin dev\"",
    "dev:server": "pnpm --filter @carbon/server dev",
    "dev:public": "pnpm --filter @carbon/public dev",
    "dev:admin": "pnpm --filter @carbon/admin dev",
    "build": "pnpm --filter @carbon/public build && pnpm --filter @carbon/admin build",
    "setup": "node apps/server/setup.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
